---
import DmShell from '../../../components/DmShell.astro';
import MapLightbox from '../../../components/MapLightbox.astro';
import { regionalMaps, dungeonMaps } from '../../../lib/maps';
import { SITE_TITLE } from '../../../lib/site';

const mapsDescription = `Regional overview maps and tactical dungeon encounter maps from the world of ${SITE_TITLE} — DM reference vault.`;
---

<DmShell title="Cartography & Maps" description={mapsDescription} current="maps">
  <div class="prose">
    <header class="maps-page-header">
      <h1 class="page-title">Cartography & Maps</h1>
      <p class="maps-page-intro">
        Full-colour regional cartography and tactical dungeon encounter maps from the world of {SITE_TITLE} — DM reference and table play.
      </p>

      <nav class="maps-section-nav" aria-label="Map categories">
        <a href="#regional-maps" class="maps-section-nav__link">
          <span class="maps-section-nav__title">Regional & Overland Maps</span>
          <span class="maps-section-nav__count">{regionalMaps.length}</span>
        </a>
        <a href="#dungeon-maps" class="maps-section-nav__link">
          <span class="maps-section-nav__title">Dungeon & Encounter Maps</span>
          <span class="maps-section-nav__count">{dungeonMaps.length}</span>
        </a>
      </nav>
    </header>

    <section class="maps-category-group" id="regional-maps">
      <div class="maps-category-header">
        <h2>Regional & Overland Maps</h2>
        <p>Overview plates showing realms, continents, town settlements, and wilderness travel routes.</p>
      </div>

      {
        regionalMaps.map((map) => (
          <article class="map-entry" id={map.slug}>
            <h3>{map.title}</h3>
            <p>{map.summary}</p>
            <MapLightbox
              slug={map.slug}
              src={map.image}
              alt={map.alt}
              caption={map.title}
              width={1536}
              height={1024}
            />
          </article>
        ))
      }
    </section>

    <section class="maps-category-group" id="dungeon-maps">
      <div class="maps-category-header">
        <h2>Dungeon & Encounter Maps</h2>
        <p>Tactical floor plans, lair warrens, subterranean complexes, and battle maps for DM reference.</p>
      </div>

      {
        dungeonMaps.map((map) => (
          <article class="map-entry" id={map.slug}>
            <h3>{map.title}</h3>
            <p>{map.summary}</p>
            <MapLightbox
              slug={map.slug}
              src={map.image}
              alt={map.alt}
              caption={map.title}
              width={1536}
              height={1024}
            />
          </article>
        ))
      }
    </section>
  </div>
</DmShell>

<style>
  .maps-page-header {
    margin-bottom: 3rem;
  }

  .maps-page-intro {
    font-size: 1.1rem;
    color: var(--ink-muted);
    margin-bottom: 2rem;
  }

  .maps-section-nav {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 1.5rem 0 2.5rem;
    padding: 0.75rem;
    background: var(--paper-light);
    border: 1px solid var(--paper-edge);
    border-radius: 8px;
  }

  .maps-section-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--paper);
    border: 1px solid var(--paper-edge);
    border-radius: 6px;
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--ink);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .maps-section-nav__link:hover {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .maps-section-nav__count {
    display: inline-block;
    padding: 0.15rem 0.45rem;
    background: var(--paper-edge);
    border-radius: 12px;
    font-size: 0.8rem;
    font-family: var(--font-sans);
    font-weight: 600;
  }

  .maps-category-group {
    margin-top: 3.5rem;
    padding-top: 1rem;
  }

  .maps-category-header {
    border-bottom: 2px solid var(--ink);
    padding-bottom: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .maps-category-header h2 {
    font-family: var(--font-display);
    font-size: 2rem;
    margin: 0 0 0.35rem 0;
  }

  .maps-category-header p {
    margin: 0;
    color: var(--ink-muted);
    font-style: italic;
  }

  .map-entry h3 {
    font-family: var(--font-display);
    font-size: 1.4rem;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
</style>

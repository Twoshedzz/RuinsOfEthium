# build output
dist/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS
.DS_Store

# Astro
.astro/

# Authoring intake — local only; feed to Cursor, do not commit
publish/source/inbox/
publish/source/manuscripts/
publish/source/characters/sheets/

# ChatGPT fragments — keep folder scaffolding only.
# NOTE: the path below was wrong until Oct 2026 (it omitted workspace/), so the rule
# never matched and the raw fragments were committed to a public repo by mistake.
publish/source/workspace/chatgpt-exports/fragments/**
!publish/source/workspace/chatgpt-exports/fragments/.gitkeep
!publish/source/workspace/chatgpt-exports/fragments/_paste-template.md
!publish/source/workspace/chatgpt-exports/fragments/README.md

# Generated by scripts/sync-publish.mjs and write-build-info.mjs on every dev/build.
# Tracking these committed the same binaries twice and churned build-info on every run.
# NOTE: the generated collection folders are ignored, but config.ts is SOURCE and
# must stay tracked — without it Astro auto-generates schemaless collections and the
# build dies on a missing default. (Netlify, Oct 2026.)
src/content/
!src/content/config.ts
public/illustrations/
src/lib/build-info.ts
